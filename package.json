{
  "name": "vibecode-arcade",
  "productName": "VibeCode Arcade",
  "version": "0.1.0",
  "description": "A free, open-source launcher and marketplace shell for vibecoded games.",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/dirtcodevet/vibecode-arcade",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "node --test --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"test/*.test.ts\"",
    "validate:catalog": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-catalog.ts",
    "audit:ci": "pnpm audit --audit-level=high && pnpm --dir reveal audit --audit-level=high",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "smoke": "electron-vite build && node scripts/smoke.mjs",
    "dist": "electron-vite build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "ajv": "^8.20.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
